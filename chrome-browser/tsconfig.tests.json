{
  // Type-checks this package's test files, which the build program deliberately
  // excludes (tsconfig.json compiles `src` only, and vitest transpiles without
  // checking). Standalone: no harness-monorepo sources are pulled in.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "rootDir": "."
  },
  "include": ["src", "tests"]
}
